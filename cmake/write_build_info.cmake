# Writes the generated header of the build information (src/nts/common/build_info.cpp) with the
# engine's commit from git. Run at every build by the nts_build_info target, as
#   cmake -DNTS_SOURCE_DIR=... -DNTS_OUTPUT_FILE=... -DNTS_ENGINE_VERSION=... \
#         -DNTS_BUILD_PRESET=... -DNTS_BUILD_TYPE=... -P write_build_info.cmake
# The file is rewritten only when its content changes, so a rebuild with the same commit does not
# recompile the build information.

# Commit, with -dirty when tracked files have changes; unknown without git.
set(commit "unknown")
execute_process(
    COMMAND git -C "${NTS_SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE head_result
    OUTPUT_VARIABLE head_commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
execute_process(
    COMMAND git -C "${NTS_SOURCE_DIR}" status --porcelain --untracked-files=no
    RESULT_VARIABLE status_result
    OUTPUT_VARIABLE porcelain
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
if(head_result EQUAL 0 AND status_result EQUAL 0)
    set(commit "${head_commit}")
    if(NOT porcelain STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()

if(NTS_BUILD_TYPE STREQUAL "")
    set(build_type "unspecified")
else()
    set(build_type "${NTS_BUILD_TYPE}")
endif()

string(CONCAT content
    "// Generated by cmake/write_build_info.cmake at build time; do not edit.\n"
    "#pragma once\n"
    "\n"
    "#include <string_view>\n"
    "\n"
    "namespace nts::build_values {\n"
    "\n"
    "inline constexpr std::string_view engine_version = \"${NTS_ENGINE_VERSION}\";\n"
    "inline constexpr std::string_view engine_commit = \"${commit}\";\n"
    "inline constexpr std::string_view build_preset = \"${NTS_BUILD_PRESET}\";\n"
    "inline constexpr std::string_view build_type = \"${build_type}\";\n"
    "\n"
    "} // namespace nts::build_values\n")

get_filename_component(output_directory "${NTS_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
set(current "")
if(EXISTS "${NTS_OUTPUT_FILE}")
    file(READ "${NTS_OUTPUT_FILE}" current)
endif()
if(NOT current STREQUAL content)
    file(WRITE "${NTS_OUTPUT_FILE}" "${content}")
endif()
