# Disabled checks, with the reason for each:
#   modernize-use-trailing-return-type: the codebase keeps leading return types.
#   readability-identifier-length: short names are idiomatic for physics symbols.
#   bugprone-easily-swappable-parameters: numeric kernels take many same-typed quantities.
#   readability-magic-numbers: physical constants are named where they carry meaning.
# ExcludeHeaderFilterRegex: Eigen's install path (.../eigen3/Eigen/src/...) matches the header
#   filter's /src/; its diagnostics (clang-analyzer false positives in its stack allocator) are
#   not ours.
# Check options with a reason:
#   misc-include-cleaner.IgnoreHeaders: HDF5's C++ API is included only through its umbrella
#     header H5Cpp.h; its component headers are not self-contained. Eigen is included only
#     through its module headers (Eigen/Sparse, ...); its Eigen/src headers are internal.
#   misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic:
#     plain aggregates (all members public, no invariant) are the standards' data records.
#   readability-function-cognitive-complexity.IgnoreMacros: GoogleTest assertion macros expand
#     to branches that are not the test's own logic.
Checks: 'bugprone-*,performance-*,modernize-*,readability-*,misc-*,clang-analyzer-*,-modernize-use-trailing-return-type,-readability-identifier-length,-bugprone-easily-swappable-parameters,-readability-magic-numbers'
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|tests|app)/.*'
ExcludeHeaderFilterRegex: '.*/eigen3/.*'
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'H5[A-Za-z]*\.h;Eigen/.*'
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.NamespaceCase: lower_case
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  readability-function-cognitive-complexity.IgnoreMacros: true
